# Copy to .env and fill in the values for your deployment.
# Never commit a real .env file — it may contain secrets.

# --- Client (Vite) ---
# Base URL of the deployed API server. The client calls
# ${VITE_API_URL}/api/analyze/... and ${VITE_API_URL}/api/audit.
# Leave empty for local development (same-origin API on :4000).
# On Vercel, set this to your Render API URL, e.g. https://rav-api.onrender.com
VITE_API_URL=

# --- Server ---
# Port the API server listens on (default: 4000).
PORT=4000

# OpenAI API key for the server-side AI audit (POST /api/audit).
# SERVER ONLY — never put this in a VITE_* variable: Vite inlines VITE_*
# variables into the browser bundle, where anyone can read them.
# When unset, the client falls back to a local rule-based summary and
# labels it as such in the UI.
OPENAI_API_KEY=

# Optional GitHub personal access token (classic or fine-grained, public_repo
# scope is enough). Raises the GitHub API quota from 60 to 5,000 req/hour.
# Without it, repository loads share the unauthenticated quota.
GITHUB_TOKEN=

# Optional: restrict API access to the deployed client origin, e.g.
# https://react-architecture-visualizer.vercel.app
# When unset, the API allows all origins (fine for local development).
CLIENT_ORIGIN=
