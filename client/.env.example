# Client environment variables (Vite). Copy to .env for local overrides.
#
# VITE_API_URL — base URL of the deployed API server, e.g.
# https://rav-api.onrender.com (leave empty for local development, where the
# API runs on http://localhost:4000). On Vercel, set this to your Render
# API URL or every analysis request will 404.
VITE_API_URL=

# NOTE: there is intentionally no VITE_-prefixed OpenAI key variable here.
# The OpenAI key lives on the server only (OPENAI_API_KEY in the server
# environment) and the client requests audits through POST /api/audit.
# Vite inlines VITE_* variables into the browser bundle, so a key in one
# would be public.
